# /usr/local/bin/pages — operator entry point for Elcano Pages.
set -euo pipefail

SRC_DIR="${PAGES_SRC_DIR:-/opt/pages-src}"
APP_DIR="${PAGES_APP_DIR:-/opt/pages}"
APP_USER="${PAGES_APP_USER:-pages}"
ENV_FILE="/etc/default/pages"
SERVICE="pages.service"

cmd="${1:-}"; shift || true

case "$cmd" in
  start)    exec sudo systemctl start "$SERVICE" ;;
  stop)     exec sudo systemctl stop "$SERVICE" ;;
  restart)  exec sudo systemctl restart "$SERVICE" ;;
  status)   exec sudo systemctl status "$SERVICE" ;;
  logs)
    if [[ $# -gt 0 ]]; then exec sudo journalctl -u "$SERVICE" "$@"; fi
    exec sudo journalctl -fu "$SERVICE"
    ;;
  update)
    [[ -d "$SRC_DIR/.git" ]] || { echo "no source checkout at $SRC_DIR" >&2; exit 1; }
    exec sudo bash "$SRC_DIR/scripts/update.sh" "$@"
    ;;
  rebuild)
    [[ -d "$SRC_DIR/.git" ]] || { echo "no source checkout at $SRC_DIR" >&2; exit 1; }
    exec sudo env PAGES_UPDATE_NO_PULL=1 PAGES_UPDATE_YES=1 bash "$SRC_DIR/scripts/update.sh"
    ;;
  env)
    [[ -f "$ENV_FILE" ]] || { echo "$ENV_FILE missing — run bootstrap.sh" >&2; exit 1; }
    # Redact secrets before printing: whole-value keys by name, plus the
    # userinfo password inside URL-shaped values (DATABASE_URL carries the
    # Postgres password and matches none of the name patterns).
    sudo awk -F= '
      /^[[:space:]]*#/    { next }
      NF>=2 {
        key = toupper($1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
        if (key ~ /TOKEN|KEY|SECRET|PASSWORD|PEPPER/ || key == "DEV_ADMIN_COOKIE") {
          printf "%s=[REDACTED]\n", $1
          next
        }
        line = $0
        # Match through the LAST raw @ in userinfo (POSIX leftmost-longest),
        # accepting an empty username as used by redis://:password@host.
        if (match(line, /\/\/[^\/[:space:]]*:[^\/[:space:]]*@/)) {
          head = substr(line, 1, RSTART - 1)
          auth = substr(line, RSTART, RLENGTH)
          tail = substr(line, RSTART + RLENGTH)
          sub(/^\/\//, "", auth)   # strip leading //  → user:pass@
          sub(/:.*/, "", auth)     # strip :pass@       → user
          printf "%s//%s:[REDACTED]@%s\n", head, auth, tail
          next
        }
        print
      }
    ' "$ENV_FILE"
    ;;
  tls)
    sub="${1:-status}"; shift || true
    case "$sub" in
      reload)   exec sudo caddy reload --config /etc/caddy/Caddyfile ;;
      restart)  exec sudo systemctl restart caddy.service ;;
      status|*)
        sudo systemctl is-active caddy.service 2>&1 || true
        [[ -f /etc/caddy/conf.d/pages.caddy ]] && grep -E '^[^[:space:]{}#].*\{$' /etc/caddy/conf.d/pages.caddy || true
        ;;
    esac
    ;;
  token)
    # Agent API tokens (PLAN §9): add/list/revoke via the installed app's
    # scripts/token.js, run as the service user with the SERVICE's env file —
    # the minted hash uses the same API_TOKEN_PEPPER the server verifies with
    # (minting with a different/absent pepper yields a token the server
    # rejects, which is exactly the trap this wiring closes).
    [[ -f "$ENV_FILE" ]] || { echo "$ENV_FILE missing — run bootstrap.sh first" >&2; exit 1; }
    [[ -f "$APP_DIR/scripts/token.js" ]] || { echo "no app install at $APP_DIR — run bootstrap.sh first" >&2; exit 1; }
    exec sudo runuser -u "$APP_USER" -- bash -c '
      env_file="$1"; app_dir="$2"; shift 2
      set -a; . "$env_file"; set +a
      cd "$app_dir"
      exec node scripts/token.js "$@"
    ' _ "$ENV_FILE" "$APP_DIR" "$@"
    ;;
  template)
    # Page templates from FILES (docs/TEMPLATES.md): one stored design, many
    # pages. Same wiring as `token` — the installed app's scripts/template.js,
    # run as the service user with the SERVICE's env file so it reaches the same
    # database the server does.
    #
    #   pages template list
    #   pages template register <file> [--name X] [--title T]
    #   pages template sync [dir]        # default: the app's own templates/
    #
    # `sync` is what a deploy runs; it is idempotent (identical bytes dedupe to
    # the same revision) and moves NO deployed page — every page stays pinned to
    # the revision it was built from.
    [[ -f "$ENV_FILE" ]] || { echo "$ENV_FILE missing — run bootstrap.sh first" >&2; exit 1; }
    [[ -f "$APP_DIR/scripts/template.js" ]] || { echo "no app install at $APP_DIR — run bootstrap.sh first" >&2; exit 1; }
    exec sudo runuser -u "$APP_USER" -- bash -c '
      env_file="$1"; app_dir="$2"; shift 2
      set -a; . "$env_file"; set +a
      cd "$app_dir"
      exec node scripts/template.js "$@"
    ' _ "$ENV_FILE" "$APP_DIR" "$@"
    ;;
  # ── Phase 1+ subcommands (stubs today; wired as the app grows) ──────────
  page|theme|backup|check-integrity)
    echo "'pages $cmd' arrives with Phase ${PAGES_PHASE_HINT:-1+}. See PLAN.md §9." >&2
    exit 2
    ;;
  help|-h|--help|"")
    cat <<'EOF'
pages — Elcano Pages operator CLI

  pages start | stop | restart | status
  pages logs [journalctl args...]
  pages update                 git pull + npm ci + (migrations) + restart
                               (PAGES_UPDATE_YES=1 to skip the prompt)
  pages rebuild                rebuild current checkout (skip fetch; post-rollback)
  pages env                    print /etc/default/pages (secrets redacted)
  pages tls status|reload|restart
  pages token add <label> [scope] [slug ...]
                                      mint a token; data_update requires exact slugs
  pages token list                     list tokens (prefix, label, state)
  pages token revoke <id>              revoke a token (server 401s it)
  pages template list                  registered templates + how many pages use each
  pages template show <name> [--revision N]
  pages template register <file> [--name X] [--title T] [--description D]
                                       register one file (any path — a bundle's too)
  pages template sync [dir]            register every templates/<name>/template.html
                                       (deploy runs this; idempotent, moves no page)

  Planned (PLAN.md §9):
  pages page list|passwd|disable|enable
  pages theme set|list
  pages backup [dest]                  pg_dump THEN tar assets/
  pages check-integrity                refs ↔ files, pointer sanity
EOF
    ;;
  *)
    echo "unknown command: $cmd" >&2
    exec "$0" --help
    ;;
esac
