# Installed by `pages bootstrap` / `pages update` (rendered with the box's
# installation settings: account, application directory, environment file).
# The application is ONE binary in the active release, reached through the
# /opt/pages symlink; `pages update` switches that link and restarts.
[Unit]
Description=Elcano Pages — versioned client dashboards
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=pages
Group=pages
WorkingDirectory=/opt/pages
EnvironmentFile=/etc/default/pages
Environment=PAGES_ENV=production
ExecStart=/opt/pages/pages serve
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHome=true
ProtectSystem=strict
# Asset uploads land here; add more ReadWritePaths as needed.
ReadWritePaths=/opt/pages/assets
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
# A Go binary never needs writable+executable memory (Node's JIT did).
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
