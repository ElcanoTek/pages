# Pages — environment reference.
#
# In production this file lives at /etc/default/pages (written by
# scripts/bootstrap.sh, mode 0640, owned root:pages) and is read by systemd via
# EnvironmentFile. For local development: `cp .env.example .env`.
#
# scripts/dev.sh and scripts/dev-macos.sh set everything you need for local dev
# themselves, including generated secrets — you do not need this file to run
# them. Full deployment guide: docs/DEPLOYMENT.md.
#
# Every variable the application reads is listed here. Commented-out lines show
# the built-in default. Placeholder values are NOT usable secrets.

PORT="3002"

# Set this in production. It enables the fail-closed secret checks below and
# stops Express from putting stack traces in error responses.
# NODE_ENV="production"

# ── The two hostnames (the trust split) ─────────────────────────────────────
# One process, two hostnames. The trusted auth zone (admin shell, /view, REST
# API, MCP) and the SEPARATE cookieless content domain that renders untrusted
# agent HTML (/<slug>, /raw, /assets).
#
# THEY MUST BE DIFFERENT REGISTRABLE DOMAINS (different eTLD+1) IN PRODUCTION.
# A subdomain is not a security boundary: a script on a sibling subdomain can
# write a cookie scoped to the shared parent domain and have it sent to the
# trusted host (cookie tossing). See docs/DEPLOYMENT.md §1 and PLAN.md §7.
DASHBOARD_HOST="pages.example.com"
CONTENT_HOST="example-pages.com"

# Origins default to https://<host>. Set these only to override the scheme.
# DASHBOARD_ORIGIN="https://pages.example.com"
# CONTENT_ORIGIN="https://example-pages.com"

# LOCAL DEV ONLY: treat one extra hostname as the content host.
# CONTENT_HOST_ALSO="content.localhost"

# ── Secrets (generated by bootstrap.sh; required in production) ─────────────
# Generate each with: openssl rand -hex 32
# With NODE_ENV=production, an empty value for any of the three THROWS at
# startup rather than silently accepting forgeable tokens.
#
# PAGE_COOKIE_SECRET=""   # HMAC for per-page client-password session cookies
# RAW_TOKEN_SECRET=""     # HMAC for signed {page,version,purpose,exp,sid} /raw tokens
# API_TOKEN_PEPPER=""     # pepper for hashing agent bearer tokens + upload tickets
#                         # (lib/tokens.js). MUST stay stable: changing it
#                         # invalidates every issued token and ticket at once.
#
# HMAC key for admin CSRF tokens. Falls back to PAGE_COOKIE_SECRET, then
# RAW_TOKEN_SECRET. Normally leave unset.
# ADMIN_CSRF_SECRET=""

# ── Authentication ──────────────────────────────────────────────────────────
# Pages VERIFIES an SSO cookie; it does not implement login. This is the
# external signing service's Ed25519 PUBLIC key: base64, exactly 32 bytes
# decoded. Empty ⇒ every admin request bounces to AUTH_LOGIN_URL.
AUTH_SIGNING_PUBKEY=""
AUTH_COOKIE_NAME="elcano_auth"          # cookie name to verify
AUTH_LOGIN_URL="https://auth.example.com"   # where auth failures redirect
ADMIN_EMAIL_DOMAIN="example.com"        # cookie emails in this domain auto-admin

# ── Database ────────────────────────────────────────────────────────────────
# Required by the /api/v1 surface and /raw rendering. If unset, lib/db.js falls
# back to the standard libpq PG* variables (PGHOST/PGPORT/PGUSER/PGDATABASE).
# bootstrap.sh generates the password; scripts/dev.sh sets PG* for you locally.
# DATABASE_URL="postgres://pages:CHANGEME@127.0.0.1:5432/pages?sslmode=disable"

# Bounded DB waits (lib/db.js) — fail fast instead of letting one wedged
# page-lock transaction pin every pool client and hang both hosts.
# Milliseconds; 0 disables a bound. Defaults shown.
# PG_CONNECT_TIMEOUT_MS="5000"     # pool.connect() wait when PG is unreachable
# PG_STATEMENT_TIMEOUT_MS="15000"  # per-statement cap (server-side)
# PG_LOCK_TIMEOUT_MS="10000"       # max wait on a row lock (FOR UPDATE convoy)
# PG_IDLE_TXN_TIMEOUT_MS="30000"   # kill sessions idle mid-transaction

# ── MCP remote-transport boundary ───────────────────────────────────────────
# DASHBOARD_HOST / DASHBOARD_ORIGIN are allowed automatically. Add
# comma-separated exceptions only for a deliberate reverse-proxy or browser
# client: host entries are hostnames (no scheme or port), origin entries are
# exact origins (scheme + host + optional port).
# MCP_ALLOWED_HOSTS="mcp.internal.example"
# MCP_ALLOWED_ORIGINS="https://inspector.internal.example,http://127.0.0.1:6274"

# ── Rate limits (per IP, per minute unless noted) ────────────────────────────
# RL_API_PER_MIN="120"          # /api/v1 and /upload/:id
# RL_MCP_PER_MIN="120"          # /mcp
# RL_CONTENT_PER_MIN="240"      # content-host reads
# RL_PASSWORD_TRIES="20"        # password-form attempts per window
# RL_PASSWORD_WINDOW_MIN="15"   # password window, in minutes
# A per-page progressive backoff sits underneath these. It is not configurable
# and deliberately delays the 401 rather than locking a real viewer out.

# ── Payload and upload bounds ───────────────────────────────────────────────
# MAX_HTML_BYTES="2mb"                    # JSON body limit (an Express size string)
# PAGE_UPLOAD_MAX_CHUNK_BYTES="49152"     # 48 KiB; hard-clamped at 256 KiB by
#                                         # the app AND a database CHECK
# PAGE_UPLOAD_TICKET_TTL_MINUTES="15"     # upload-ticket lifetime
# PAGES_MCP_MAX_INLINE_DATA_BYTES="1500000"  # largest inline MCP data payload

# ── Managed dashboard-data safety bounds ────────────────────────────────────
# CPU/memory guards on agent-supplied JSON Schemas and data. Bytes unless the
# name says otherwise. Raising one raises the cost of a single hostile call.
# PAGES_DATA_SCHEMA_MAX_BYTES="262144"
# PAGES_DATA_MAX_BYTES="1048576"
# PAGES_DATA_CONFIG_MAX_BYTES="262144"
# PAGES_DATA_TEMPLATE_MAX_BYTES="2097152"
# PAGES_DATA_SCHEMA_MAX_NODES="10000"
# PAGES_DATA_SCHEMA_MAX_DEPTH="100"
# PAGES_SOURCE_FUTURE_TOLERANCE_MS="300000"  # tolerance for a source timestamp
#                                            # that claims to be in the future

# ── Theming ─────────────────────────────────────────────────────────────────
# Base URL for the vendored Flag design-system assets. Change only if you serve
# them from somewhere other than this app's /assets mount.
# FLAG_ASSETS_BASE="/assets/flag"

# ── DEVELOPMENT ONLY — never set any of these in production ─────────────────
# PAGES_DEV_LOGIN=1 exposes GET /__dev/login, which sets an admin cookie with
# NO AUTHENTICATION AT ALL. It requires DEV_ADMIN_COOKIE to be set too, and
# bootstrap.sh never writes either. scripts/dev.sh sets all three.
# PAGES_DEV_LOGIN="1"
# DEV_ADMIN_COOKIE=""
# DEV_ADMIN_EMAIL="dev@example.com"

# An optional local "compose" panel that shells out to an external authoring
# CLI. Dev-only, and irrelevant to a deployment that is not ElcanoTek's:
# PAGES_COMPOSE="1"
# COMPOSE_DRIVER="spawn"        # "spawn" (local subprocess) or "moc" (remote)
# CUTLASS_BIN=""                # spawn driver: path to the authoring CLI
# CUTLASS_DIR=""                # spawn driver: its working directory
# COMPOSE_TIMEOUT_MS="0"        # 0 = no time limit
# COMPOSE_POLL_MS="3000"
# The "moc" driver targets an ElcanoTek-internal orchestration service. Pages
# itself runs no scheduler and holds no model credentials.
# MOC_URL=""
# MOC_API_KEY=""
# MOC_MODEL=""
# MOC_FALLBACK_MODEL=""
# MOC_TARGET_NODE_NAME=""

# Test-harness only: overrides the Playwright fixture server's port so two
# checkouts can run the browser suite at the same time.
# PLAYWRIGHT_FIXTURE_PORT="3210"
