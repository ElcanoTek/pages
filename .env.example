# Elcano Pages — environment. In production this is /etc/default/pages
# (written by scripts/bootstrap.sh, mode 0640, owned by the `pages` user).
# Copy to .env for local dev: `cp .env.example .env`.

PORT="3002"

# ── The two hostnames (PLAN.md §3, §7) ──────────────────────────────────
# Trusted auth zone (shells, API, MCP) and the SEPARATE registrable content
# domain (cookieless /raw + /assets). They MUST be different eTLD+1s in prod —
# a *.elcanotek.com subdomain is NOT a security boundary (cookie-tossing).
DASHBOARD_HOST="pages.elcanotek.com"
CONTENT_HOST="elcano-pages.com"
# Origins default to https://<host>; only set these to override the scheme.
# DASHBOARD_ORIGIN="https://pages.elcanotek.com"
# CONTENT_ORIGIN="https://elcano-pages.com"
# Local dev only: treat an extra hostname as the content host (e.g. localhost).
# CONTENT_HOST_ALSO="content.localhost"

# ── Elcano unified auth (copied from home) ──────────────────────────────
# Auth service's Ed25519 PUBLIC key (base64, 32 bytes) — verifies elcano_auth.
# Copy from the auth host (`auth-admin keygen` / auth's bootstrap output).
AUTH_SIGNING_PUBKEY=""
AUTH_COOKIE_NAME="elcano_auth"
AUTH_LOGIN_URL="https://auth.elcanotek.com"
ADMIN_EMAIL_DOMAIN="elcanotek.com"      # email domain that auto-admins

# ── Secrets (generated by bootstrap; Phase 1+) ──────────────────────────
# PAGE_COOKIE_SECRET=""    # HMAC for per-page client password sessions
# RAW_TOKEN_SECRET=""      # HMAC for signed {page,version,purpose,exp,sid} /raw tokens
# API_TOKEN_PEPPER=""      # server pepper for hashing agent bearer tokens

# ── Database (Phase 1) ──────────────────────────────────────────────────
# DATABASE_URL="postgres://pages:***@127.0.0.1:5432/pages?sslmode=disable"
